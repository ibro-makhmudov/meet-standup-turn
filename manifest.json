{
  "manifest_version": 3,
  "name": "Meet Standup Turn",
  "version": "1.6.1",
  "description": "Google Meet standup in alphabetical order: shows after whom you speak, and optionally who starts today.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Meet Standup Turn",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "rotation.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
